10 'Set the Regsiter Buffer index to 0
20 OUT &F9E0,0
30 'Read the Registers
40 DIM REG(39):FOR I=0 TO 38:REG[I]=INP(&F9E0):NEXT
50 'CRTC Register Indexes and Last CRTC Register (LR)
60 R0=0:R15=15:LR=16
70 'Pen indexes and Last Pen (LP)
80 P0=17:P16=33:LP=34
90 'RMR, MMR and MMR2 Indexes   
100 RMR=35:MMR=36:MMR2=37
110 'Error Code
120 E=38
130 MODE 2
140 'Print the CRTC Registers'
150 LOCATE 1,1:PRINT "CRTC ";:FOR R=R0 TO R15:PRINT USING "## ";R;:NEXT
160 LOCATE 6,2
170 FOR I=R0 TO R15
180 IF I=REG[LR] THEN PRINT CHR$(24) HEX$(REG[I],2) CHR$(24); ELSE PRINT HEX$(REG[I],2);
190 PRINT " ";
200 NEXT
210 'Print the Pen Registers
220 LOCATE 1,4:PRINT "PEN  ";:FOR P=P0 TO P16:PRINT USING "## ";P-P0;:NEXT
230 LOCATE 6,5
240 FOR I=P0 TO P16
250 IF I-P0=REG[LP] THEN PRINT CHR$(24) HEX$(REG[I],2) CHR$(24); ELSE PRINT HEX$(REG[I],2);
260 PRINT " ";
270 NEXT
280 'Print the RMR, MMR and MMR2 Registers
290 LOCATE 1,7:PRINT "RMR  ";:PRINT HEX$(REG[RMR],2)
300 LOCATE 1,9:PRINT "MMR  ";:PRINT HEX$(REG[MMR],2)
310 LOCATE 1,11:PRINT "MMR2 ";:PRINT HEX$(REG[MMR2],2)
320 'Print the Error Code
330 LOCATE 1,13:PRINT "ERR  ";:PRINT HEX$(REG[E],2)
